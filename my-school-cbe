function startExam(examId) {
    const data = getData();
    currentExam = data.exams.find(e => e.id === examId);
    if (!currentExam) return;
    if (!confirm(`Start exam:\n"${currentExam.title}"\n\nDuration: ${currentExam.duration} minutes\nTotal: ${currentExam.totalMarks} marks\n\nThe timer cannot be paused. Good luck!`)) return;
    currentPhase = 1; currentQuestionIndex = 0; studentAnswers = {};
    document.getElementById('studentDashboard').classList.remove('active');
    document.getElementById('examInterface').classList.add('active');
    document.getElementById('examTitleDisplay').textContent = currentExam.title;
    const course = data.courses.find(c => c.id === currentExam.courseId);
    document.getElementById('examMetaDisplay').textContent = `${course ? course.code : currentExam.courseId} | ${currentExam.duration} mins | ${currentExam.totalMarks} marks`;
    document.getElementById('phase1Btn').className = 'phase active';
    document.getElementById('phase2Btn').className = 'phase phase-locked';
    timeRemaining = currentExam.duration * 60;
    startTimer(); renderQuestion(); buildPalette();
}

function startTimer() {
    clearInterval(examTimer);
    examTimer = setInterval(() => {
        timeRemaining--;
        const m = Math.floor(timeRemaining/60), s = timeRemaining%60;
        const el = document.getElementById('timer');
        el.textContent = String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
        if (timeRemaining <= 300) el.classList.add('warning');
        if (timeRemaining <= 0) { clearInterval(examTimer); submitExam(); }
    }, 1000);
}

function getPhaseQuestions(phase) { return currentExam.questions.filter(q => q.phase === phase); }

function renderQuestion() {
    const pQs = getPhaseQuestions(currentPhase);
    const q = pQs[currentQuestionIndex];
    if (!q) return;
    let html = `<div class="question-number">Question ${currentQuestionIndex+1} of ${pQs.length} — Phase ${currentPhase} (${currentPhase===1?'Objective / Sub-Objective':'Theory'})</div>`;
    html += `<div class="question-text">${q.text}</div>`;
    if (q.type === 'objective' || q.type === 'sub-objective') {
        html += '<div class="options-list">';
        Object.entries(q.options).forEach(([k,v]) => {
            const sel = studentAnswers[q.id] === k ? 'selected' : '';
            html += `<label class="option-label ${sel}" onclick="selectAnswer(${q.id},'${k}',this)">
                <input type="radio" name="q${q.id}" value="${k}" ${sel?'checked':''}><strong style="margin-right:9px;">${k}.</strong>${v}
            </label>`;
        });
        html += '</div>';
    } else {
        const saved = studentAnswers[q.id] || '';
        html += `<textarea class="theory-answer" id="theoryAnswer_${q.id}" placeholder="Write your answer here..." oninput="saveTheoryAnswer(${q.id})">${saved}</textarea>
            <div style="font-size:12px;color:#888;margin-top:7px;">Marks available: ${q.marks}</div>`;
    }
    document.getElementById('questionContainer').innerHTML = html;
    document.getElementById('prevBtn').disabled = currentQuestionIndex === 0;
    document.getElementById('nextBtn').disabled = currentQuestionIndex >= pQs.length - 1;
    const npBtn = document.getElementById('nextPhaseBtn');
    if (currentPhase === 1 && currentQuestionIndex === pQs.length - 1) { npBtn.textContent = 'Complete Phase 1 →'; npBtn.style.display = 'inline-block'; }
    else if (currentPhase === 2 && currentQuestionIndex === pQs.length - 1) { npBtn.textContent = '✅ Submit Exam'; npBtn.style.display = 'inline-block'; }
    else npBtn.style.display = 'none';
    updatePalette();
}

function selectAnswer(qId, opt, labelEl) {
    studentAnswers[qId] = opt;
    document.querySelectorAll('.option-label').forEach(l => l.classList.remove('selected'));
    labelEl.classList.add('selected');
    updatePalette();
}

function saveTheoryAnswer(qId) { const el = document.getElementById('theoryAnswer_'+qId); if (el) studentAnswers[qId] = el.value; }
function saveCurrentTheory() { const q = getPhaseQuestions(currentPhase)[currentQuestionIndex]; if (q && q.type==='theory') saveTheoryAnswer(q.id); }
function prevQuestion() { if (currentQuestionIndex>0) { saveCurrentTheory(); currentQuestionIndex--; renderQuestion(); } }
function nextQuestion() { saveCurrentTheory(); const p=getPhaseQuestions(currentPhase); if (currentQuestionIndex<p.length-1){currentQuestionIndex++;renderQuestion();} }

function nextPhaseOrSubmit() {
    saveCurrentTheory();
    if (currentPhase === 1) {
        const p1 = getPhaseQuestions(1);
        const un = p1.filter(q => !studentAnswers[q.id]).length;
        if (!confirm(`Complete Phase 1?\nAnswered: ${p1.length-un}/${p1.length}${un>0?'\n⚠️ '+un+' unanswered':''}\n\nYou CANNOT return to Phase 1 after this.`)) return;
        currentPhase = 2; currentQuestionIndex = 0;
        document.getElementById('phase1Btn').className = 'phase completed';
        document.getElementById('phase2Btn').className = 'phase active';
        buildPalette(); renderQuestion();
    } else {
        const p2 = getPhaseQuestions(2);
        const un = p2.filter(q => !studentAnswers[q.id] || studentAnswers[q.id].trim()==='').length;
        if (!confirm(`Submit exam?\nPhase 2 answered: ${p2.length-un}/${p2.length}${un>0?'\n⚠️ '+un+' unanswered':''}`)) return;
        submitExam();
    }
}

function buildPalette() {
    const pQs = getPhaseQuestions(currentPhase);
    document.getElementById('questionPalette').innerHTML = pQs.map((q,i) => {
        const ans = studentAnswers[q.id];
        const answered = ans && (typeof ans==='string' && ans.trim()!=='');
        return `<button class="palette-btn ${answered?'answered':''} ${i===currentQuestionIndex?'current':''} ${currentPhase===2?'phase2':''}" onclick="jumpToQuestion(${i})">${i+1}</button>`;
    }).join('');
}

function updatePalette() { buildPalette(); }
function jumpToQuestion(i) { saveCurrentTheory(); currentQuestionIndex=i; renderQuestion(); }

function submitExam() {
    clearInterval(examTimer); saveCurrentTheory();
    const data = getData();
    let phase1Score = 0;
    getPhaseQuestions(1).forEach(q => { if (studentAnswers[q.id] === q.correctAnswer) phase1Score += q.marks; });
    let phase2Score = 0;
    getPhaseQuestions(2).forEach(q => {
        const ans = (studentAnswers[q.id]||'').toLowerCase().trim();
        if (!ans) return;
        const keywords = (q.modelAnswer||'').split(',').map(k=>k.trim().toLowerCase()).filter(k=>k);
        if (!keywords.length) { phase2Score += Math.round(q.marks*0.5); return; }
        let hits = 0; keywords.forEach(kw=>{if(ans.includes(kw))hits++;});
        let awarded = Math.round(q.marks * Math.min((hits/keywords.length)*1.5,1));
        if (ans.length>50) awarded = Math.max(awarded, Math.round(q.marks*0.3));
        phase2Score += Math.min(awarded, q.marks);
    });
    const sub = { id:'SUB'+Date.now(), studentId:currentUser.id, examId:currentExam.id, phase1Score, phase2Score, totalScore:phase1Score+phase2Score, submittedAt:new Date().toISOString() };
    data.submissions.push(sub); saveData(data);
    showResults(sub);
}

function showResults(sub) {
    document.getElementById('examInterface').classList.remove('active');
    document.getElementById('resultsScreen').classList.add('active');
    const data = getData();
    const exam = data.exams.find(e => e.id === sub.examId);
    document.getElementById('resultExamTitle').textContent = exam ? exam.title : 'Exam';
    document.getElementById('scoreDisplay').textContent = sub.totalScore;
    const grade = getGrade(sub.totalScore);
    const gb = document.getElementById('gradeBadge');
    gb.textContent = grade; gb.className = 'grade-badge grade-' + grade.toLowerCase();
    document.getElementById('scoreBreakdown').innerHTML = `
        <div class="composite-item"><div class="composite-value">${sub.phase1Score}</div><div class="composite-label">Phase 1<br><small>(/${exam?exam.phase1Marks:20})</small></div></div>
        <div class="composite-item"><div class="composite-value">${sub.phase2Score}</div><div class="composite-label">Phase 2<br><small>(/${exam?exam.phase2Marks:40})</small></div></div>
        <div class="composite-item"><div class="composite-value">${sub.totalScore}</div><div class="composite-label">Total<br><small>(/60)</small></div></div>
        <div class="composite-item"><div class="composite-value">${((sub.totalScore/60)*100).toFixed(1)}%</div><div class="composite-label">Percentage</div></div>
        <div class="composite-item"><div class="composite-value">${grade}</div><div class="composite-label">Grade</div></div>
        <div class="composite-item"><div class="composite-value" style="color:${sub.totalScore>=36?'#2e7d32':'#c62828'}">${sub.totalScore>=36?'PASS':'FAIL'}</div><div class="composite-label">Status</div></div>`;
}

function returnToDashboard() {
    document.getElementById('resultsScreen').classList.remove('active');
    document.getElementById('studentDashboard').classList.add('active');
    document.getElementById('studentExamsSection').classList.add('hidden');
    document.getElementById('studentCoursesSection').classList.remove('hidden');
    loadStudentCourses(); loadStudentRecord();
}

function downloadResultSlip() {
    const data = getData();
    const sub = data.submissions.filter(s => s.studentId === currentUser.id).slice(-1)[0];
    if (!sub) return;
    const exam = data.exams.find(e => e.id === sub.examId) || {};
    const course = data.courses.find(c => c.id === (exam.courseId||'')) || {};
    const grade = getGrade(sub.totalScore);
    const slip = `AMADEUS UNIVERSITY, AMIZI\nCOMPUTER BASED EXAMINATION RESULT SLIP\n${'='.repeat(50)}\n\nStudent: ${currentUser.name}\nStudent ID: ${currentUser.id}\nDepartment: ${currentUser.department||''}\n\nExam: ${exam.title||''}\nProgramme: ${course.code||''} — ${course.name||''}\n\nPhase 1 Score: ${sub.phase1Score} / ${exam.phase1Marks||20}\nPhase 2 Score: ${sub.phase2Score} / ${exam.phase2Marks||40}\nTotal Score: ${sub.totalScore} / 60\nPercentage: ${((sub.totalScore/60)*100).toFixed(1)}%\nGrade: ${grade}\nStatus: ${sub.totalScore>=36?'PASS':'FAIL'}\n\nDate: ${new Date(sub.submittedAt).toLocaleString()}\n\n${'='.repeat(50)}\n"Knowledge and Light"`;
    const blob = new Blob([slip],{type:'text/plain'});
    const a = document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='result_slip.txt'; a.click();
}

// =====================================================================
//  UTILITY
// =====================================================================
function showAlert(id, msg, type) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg; el.className = 'alert alert-'+type+' show';
    setTimeout(() => el.classList.remove('show'), 4500);
}

