function saveUser() {
    const data = getData();
    const type = currentModalUserType;
    const id = document.getElementById('userId').value.trim();
    const name = document.getElementById('userName').value.trim();
    const pass = document.getElementById('userPass').value || 'password123';
    const email = document.getElementById('userEmail').value.trim();
    if (!name) { alert('Please enter a name'); return; }

    let newId = id;
    if (type === 'admin') {
        if (!newId) { const max = Math.max(...data.admins.map(a => parseInt(a.id.replace('ADMIN','')) || 0), 0); newId = 'ADMIN' + String(max+1).padStart(3,'0'); }
        const user = { id: newId, name, email, password: pass, status: 'active' };
        if (editingUserId) { const i = data.admins.findIndex(a => a.id === editingUserId); data.admins[i] = { ...data.admins[i], ...user, id: editingUserId }; }
        else { if (data.admins.some(a => a.id === newId)) { alert('Admin ID exists'); return; } data.admins.push(user); }
    } else if (type === 'staff') {
        const faculty = document.getElementById('userFaculty').value;
        const dept = document.getElementById('userDept').value;
        if (!faculty || !dept) { alert('Please select faculty and department'); return; }
        if (!newId) { const max = Math.max(...data.staff.map(s => parseInt(s.id.replace('AUA','')) || 0), 0); newId = 'AUA' + String(max+1).padStart(5,'0'); }
        const user = { id: newId, name, faculty, department: dept, email, password: pass, status: 'active' };
        if (editingUserId) { const i = data.staff.findIndex(s => s.id === editingUserId); data.staff[i] = { ...data.staff[i], ...user, id: editingUserId }; }
        else { if (data.staff.some(s => s.id === newId)) { alert('Staff ID exists'); return; } data.staff.push(user); }
    } else {
        const faculty = document.getElementById('userFaculty').value;
        const dept = document.getElementById('userDept').value;
        const year = parseInt(document.getElementById('userYear').value);
        const courses = Array.from(document.getElementById('userCourses').selectedOptions).map(o => o.value);
        if (!faculty || !dept) { alert('Please select faculty and department'); return; }
        if (!newId) {
            const yr = new Date().getFullYear();
            const max = Math.max(...data.students.filter(s => s.id.startsWith(yr+'')).map(s => parseInt((s.id.split('/')[2])) || 0), 0);
            newId = yr + '/ABU/' + String(max+1).padStart(4,'0');
        }
        const user = { id: newId, name, faculty, department: dept, year, courses, email, password: pass };
        if (editingUserId) { const i = data.students.findIndex(s => s.id === editingUserId); data.students[i] = { ...data.students[i], ...user, id: editingUserId }; }
        else { if (data.students.some(s => s.id === newId)) { alert('Student ID exists'); return; } data.students.push(user); }
    }
    saveData(data); closeUserModal();
    loadAdminStaffTable(); loadAdminStudentsTable(); loadAdminAdminsTable(); updateAdminStats();
}

function editUser(type, id) {
    const data = getData();
    currentModalUserType = type;
    editingUserId = id;
    let user;
    if (type === 'admin') user = data.admins.find(u => u.id === id);
    else if (type === 'staff') user = data.staff.find(u => u.id === id);
    else user = data.students.find(u => u.id === id);

    openUserModal(type);
    document.getElementById('userModalTitle').textContent = 'Edit ' + (type === 'admin' ? 'Administrator' : type === 'staff' ? 'Staff' : 'Student');
    editingUserId = id;
    document.getElementById('userId').value = user.id;
    document.getElementById('userName').value = user.name;
    document.getElementById('userEmail').value = user.email || '';

    if (type !== 'admin') {
        document.getElementById('userFaculty').value = user.faculty || '';
        populateUserDept();
        setTimeout(() => { document.getElementById('userDept').value = user.department || ''; }, 50);
    }
    if (type === 'student') {
        document.getElementById('userYear').value = user.year;
        setTimeout(() => {
            Array.from(document.getElementById('userCourses').options).forEach(o => { o.selected = (user.courses || []).includes(o.value); });
        }, 50);
    }
}

