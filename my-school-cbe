function selectRole(role, btn) {
    userRole = role;
    document.querySelectorAll('.role-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const labels = { admin:'Admin ID', staff:'Staff ID', student:'Student ID' };
    const placeholders = { admin:'e.g., ADMIN001', staff:'e.g., AUA00001', student:'e.g., 2026/ABU/0001' };
    const defaults = { admin:'ADMIN001', staff:'AUA00001', student:'2026/ABU/0001' };
    document.getElementById('loginIdLabel').textContent = labels[role];
    document.getElementById('loginId').placeholder = placeholders[role];
    document.getElementById('loginId').value = defaults[role];
    document.getElementById('loginPass').value = role === 'admin' ? 'admin123' : role === 'staff' ? 'staff123' : 'student123';
}

function login() {
    const data = getData();
    const id = document.getElementById('loginId').value.trim();
    const pass = document.getElementById('loginPass').value;
    let user;

    if (userRole === 'admin') {
        user = data.admins.find(u => u.id === id && u.password === pass && u.status === 'active');
    } else if (userRole === 'staff') {
        user = data.staff.find(u => u.id === id && u.password === pass && u.status === 'active');
    } else {
        user = data.students.find(u => u.id === id && u.password === pass);
    }

    if (!user) { showAlert('loginAlert', 'Invalid ID or password. Please try again.', 'error'); return; }
    currentUser = { ...user, role: userRole };
    document.getElementById('loginScreen').classList.add('hidden');

    if (userRole === 'admin') {
        document.getElementById('adminDashboard').classList.add('active');
        document.getElementById('adminNameDisplay').textContent = user.name;
        document.getElementById('adminIdDisplay').textContent = user.id;
        updateAdminStats();
        loadAdminStaffTable();
        loadAdminStudentsTable();
        loadAdminAdminsTable();
        renderFaculties();
        loadAdminCourses();
    } else if (userRole === 'staff') {
        document.getElementById('staffDashboard').classList.add('active');
        document.getElementById('staffNameDisplay').textContent = user.name;
        document.getElementById('staffIdDisplay').textContent = user.id;
        populateStaffSelects();
        loadStaffExams();
    } else {
        document.getElementById('studentDashboard').classList.add('active');
        document.getElementById('studentNameDisplay').textContent = user.name;
        document.getElementById('studentIdDisplay').textContent = user.id;
        loadStudentCourses();
        loadStudentRecord();
    }
}

function logout() {
    clearInterval(examTimer);
    currentUser = null; userRole = null; currentExam = null;
    currentQuestionIndex = 0; currentPhase = 1; studentAnswers = {};
    tempExamQuestions = []; editingUserId = null; uploadedFileName = '';
    document.querySelectorAll('.dashboard, .exam-interface, .results-container').forEach(el => el.classList.remove('active'));
    document.getElementById('loginScreen').classList.remove('hidden');
    document.getElementById('loginAlert').classList.remove('show');
    userRole = 'admin';
}

