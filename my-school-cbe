function generateSampleQuestions(yearLevel) {
    const qs = [];
    for (let i = 1; i <= 20; i++) {
        qs.push({ id: i, phase: 1, type: yearLevel === 1 ? 'objective' : 'sub-objective',
            text: (yearLevel === 1 ? 'Objective' : 'Sub-Objective') + ` Question ${i} (parsed from document)`,
            options: { A: 'Option A', B: 'Option B', C: 'Option C', D: 'Option D' },
            correctAnswer: 'A', marks: 1 });
    }
    for (let i = 1; i <= 4; i++) {
        qs.push({ id: 20 + i, phase: 2, type: 'theory',
            text: `Theory Question ${i} (parsed from document)`,
            modelAnswer: 'key,terms,model,answer', marks: 10 });
    }
    return qs;
}

function displayParsedQuestions(questions) {
    const p1 = questions.filter(q => q.phase === 1);
    const p2 = questions.filter(q => q.phase === 2);
    document.getElementById('parsedQuestions').innerHTML = `
        <div style="background:#e8f5e9;border:1px solid #4caf50;border-radius:10px;padding:14px;">
            <strong style="color:#2e7d32;">✅ Questions Parsed Successfully</strong>
            <div style="margin-top:9px;font-size:13px;">
                <div>• Phase 1: <strong>${p1.length} questions</strong> — ${p1.reduce((s,q)=>s+q.marks,0)} marks</div>
                <div>• Phase 2: <strong>${p2.length} questions</strong> — ${p2.reduce((s,q)=>s+q.marks,0)} marks</div>
                <div>• <strong>Total: ${questions.reduce((s,q)=>s+q.marks,0)} marks</strong></div>
            </div>
        </div>`;
}

function saveExam() {
    const title = document.getElementById('examTitle').value.trim();
    const courseId = document.getElementById('examCourse').value;
    const duration = parseInt(document.getElementById('examDuration').value);
    const yearLevel = parseInt(document.getElementById('examYear').value);
    if (!title || !courseId) { alert('Please fill all required fields'); return; }
    if (!uploadedFileName && tempExamQuestions.length === 0) { alert('Please upload an exam template file'); return; }
    const data = getData();
    const questions = tempExamQuestions.length > 0 ? tempExamQuestions : generateSampleQuestions(yearLevel);
    const exam = {
        id: 'EXAM' + Date.now(), title, courseId, year: yearLevel, duration,
        totalMarks: 60,
        phase1Marks: questions.filter(q => q.phase === 1).reduce((s,q)=>s+q.marks,0),
        phase2Marks: questions.filter(q => q.phase === 2).reduce((s,q)=>s+q.marks,0),
        fileName: uploadedFileName || 'manual.docx', questions
    };
    data.exams.push(exam);
    saveData(data); closeExamModal(); loadStaffExams(); populateStaffSelects();
}

function deleteExam(id) {
