function generateReport() {
    const data = getData();
    const courseId = document.getElementById('reportCourse') ? document.getElementById('reportCourse').value : '';
    const examId = document.getElementById('reportExam') ? document.getElementById('reportExam').value : '';
    const year = document.getElementById('reportYear') ? document.getElementById('reportYear').value : '';

    let subs = data.submissions;
    if (examId) subs = subs.filter(s => s.examId === examId);
    if (courseId) subs = subs.filter(s => { const e = data.exams.find(x => x.id === s.examId); return e && e.courseId === courseId; });
    if (year) subs = subs.filter(s => { const st = data.students.find(x => x.id === s.studentId); return st && String(st.year) === year; });

    const tbody = document.querySelector('#reportTable tbody');
    if (!tbody) return;
    if (subs.length === 0) {
        tbody.innerHTML = '<tr><td colspan="12" class="text-center" style="padding:28px;color:#777;">No submissions found for selected filters.</td></tr>';
        document.getElementById('reportSummary').classList.add('hidden');
        return;
    }
    tbody.innerHTML = subs.map((sub, i) => {
        const st = data.students.find(x => x.id === sub.studentId) || { name:'Unknown', department:'-', year:'-' };
        const exam = data.exams.find(e => e.id === sub.examId) || { title:'Unknown', courseId:'-' };
        const course = data.courses.find(c => c.id === exam.courseId) || { code: exam.courseId };
        const grade = getGrade(sub.totalScore);
        return `<tr>
            <td>${i+1}</td><td>${sub.studentId}</td><td>${st.name}</td><td style="font-size:12px;">${st.department}</td>
            <td>Year ${st.year}</td><td>${course.code}</td><td style="font-size:12px;">${exam.title}</td>
            <td>${sub.phase1Score}</td><td>${sub.phase2Score}</td>
            <td><strong>${sub.totalScore}</strong></td>
            <td><span class="grade-badge grade-${grade.toLowerCase()}" style="font-size:13px;padding:4px 12px;">${grade}</span></td>
            <td><span class="badge ${sub.totalScore>=36?'badge-success':'badge-warning'}">${sub.totalScore>=36?'Pass':'Fail'}</span></td>
        </tr>`;
    }).join('');

    const scores = subs.map(s => s.totalScore);
    const avg = (scores.reduce((a,b)=>a+b,0)/scores.length).toFixed(1);
    const passed = subs.filter(s => s.totalScore >= 36).length;
    document.getElementById('reportSummary').classList.remove('hidden');
    document.getElementById('reportStats').innerHTML = `
        <div class="composite-item"><div class="composite-value">${subs.length}</div><div class="composite-label">Submissions</div></div>
        <div class="composite-item"><div class="composite-value">${avg}</div><div class="composite-label">Average Score</div></div>
        <div class="composite-item"><div class="composite-value">${Math.max(...scores)}</div><div class="composite-label">Highest</div></div>
        <div class="composite-item"><div class="composite-value">${Math.min(...scores)}</div><div class="composite-label">Lowest</div></div>
        <div class="composite-item"><div class="composite-value">${passed}</div><div class="composite-label">Passed</div></div>
        <div class="composite-item"><div class="composite-value">${subs.length-passed}</div><div class="composite-label">Failed</div></div>`;
}

function getGrade(score) {
    const p = (score / 60) * 100;
    if (p >= 70) return 'A'; if (p >= 60) return 'B'; if (p >= 50) return 'C'; if (p >= 45) return 'D'; return 'F';
}

function exportCSV() {
